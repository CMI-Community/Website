{
  "name": "cmi-community-website",
  "version": "0.2.1",
  "private": true,
  "description": "CMI Community official website and community platform.",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "react-router build",
    "build:staging": "CLOUDFLARE_ENV=staging react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "check": "npm run lint && npm run check:trace && npm run typecheck && npm run test && npm run build && npm run deploy:dry-run",
    "check:trace": "node scripts/check-traceability.mjs",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typegen": "wrangler types --env-interface CloudflareEnv && react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "lint": "eslint . && node scripts/check-public-boundary.mjs",
    "test": "npm run test:unit && npm run test:d1",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:d1": "node scripts/test-d1-migrations.mjs",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "deploy:dry-run": "npm run build:staging && wrangler deploy --dry-run --env staging",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:production": "npm run build:production && wrangler deploy --env production"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "isbot": "5.1.36",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260804.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "allowScripts": {
    "workerd@1.20260801.1": true,
    "esbuild@0.28.1": true
  }
}
