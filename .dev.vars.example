# Copy to .dev.vars for local development. Never commit real values.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:5173
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=

# Activity admin must be explicitly configured; unset disables admin access.
EVENT_ADMIN_EMAIL=
# Rotate after any full database restore; production must have a separate secret.
INTEGRATION_KEY_EPOCH=

# Optional poster + text autofill. Secret stays in the server environment.
OPENAI_API_KEY=
EVENT_AUTOFILL_MODEL=gpt-5.4-mini
